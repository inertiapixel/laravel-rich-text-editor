{
    "name": "inertiapixel/laravel-rich-text-editor",
    "description": "InertiaPixel Rich Text Editor: a dependency-free rich text, Markdown, plain-text and source editor for Laravel, delivered as a Blade component.",
    "keywords": [
        "laravel",
        "blade",
        "rich-text",
        "wysiwyg",
        "editor",
        "markdown",
        "inertiapixel"
    ],
    "homepage": "https://github.com/inertiapixel/laravel-rich-text-editor",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "InertiaPixel",
            "homepage": "https://github.com/inertiapixel"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "suggest": {
        "ext-fileinfo": "Required by the optional built-in upload endpoint to detect real MIME types."
    },
    "autoload": {
        "psr-4": {
            "InertiaPixel\\RichTextEditor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "InertiaPixel\\RichTextEditor\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InertiaPixel\\RichTextEditor\\RichTextEditorServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
